<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Habla" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/pink_deep</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:alertDialogTheme">@style/Theme.Habla.Dialog</item>
    </style>
    <style name="Theme.Habla.Dialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/pink_deep</item>
        <item name="android:textColorPrimary">@color/ink</item>
    </style>
</resources>
